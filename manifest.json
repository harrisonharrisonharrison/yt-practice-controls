{
  "manifest_version": 3,
  "name": "YTPracticeControls",
  "version": "1.0",
  "description": "YouTube video looper and speed controller",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "practice-controls@harrisonharrisonharrison.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"], 
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}